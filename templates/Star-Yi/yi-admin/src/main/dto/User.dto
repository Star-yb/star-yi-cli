export com.star.admin.model.entity.Users
    -> package com.star.admin.model.dto


UsersView {
    #allScalars
//    id(roles) as roleIds
    -deletedTime
    -password

}
input UserCreateInputView {
    #allScalars?
    username
}


input UserUpdateInputView {
    #allScalars?
    -password
    -status
    id?

}
//修改密码
input UserPasswordUpdateInputView {
    id?
    oldPassword: String
    newPassword: String
}



//修改用户角色
dynamic  input  UserRoleUpdateInputView {
    id
    id(roles ) as roleIds
}



specification UserSpecification {
    like/i(username)
    like/i(nickname)
    like/i^(email)
    status
    superAdmin
    flat(roles) {
        id as roleId
    }
}

