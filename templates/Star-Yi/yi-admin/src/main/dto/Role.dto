export com.star.admin.model.entity.Roles
    -> package com.star.admin.model.dto


RolesView {
    #allScalars
//    id(permissions) as permissionIds
//    id(users) as userIds
    -deletedTime
}


input RoleCreateInputView {
    #allScalars?
    roleName
    roleCode
}

input RoleUpdateInputView {
    #allScalars?
    id?
    -status
}
//修改角色权限
dynamic input RolePermissionUpdateInputView {
    id
    id(permissions) as permissionIds
}

specification RoleSpecification{
    like/i(roleName)
    like/i(roleCode)
    status

}
