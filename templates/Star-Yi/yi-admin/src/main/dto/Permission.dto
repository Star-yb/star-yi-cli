export com.star.admin.model.entity.Permissions
    -> package com.star.admin.model.dto


PermissionsView {
    #allScalars
//    id(roles) as roleIds
    roles {
        id
        roleName
    }
    -deletedTime
}
PermissionsTreeView {
    #allScalars
    //    id(roles) as roleIds
    roles {
        id
        roleName
    }
    childPermissions*
    -deletedTime
}


input PermissionCreateInputView {
    #allScalars?
    permissionCode
    permissionName
    id(parent) as parentId
}
// 修改使用 dynamic 相当于局部修改 可以指定为null，不指定为不操作
dynamic input PermissionUpdateInputView {
    #allScalars?
    permissionCode
    permissionName
    id?
    -status
}

specification PermissionSpecification{

    like/i(permissionCode)
    like/i(permissionName)
    flat(parent) {
        id as parentId
    }
    flat(childPermissions) {
        id as childId
    }
    flat(roles) {
        id as roleId
    }
    status


}