<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>{groupId}</groupId>
    <artifactId>{projectArtifactId}</artifactId>
    <version>{version}</version>
    <packaging>pom</packaging>
    <name>{projectName}</name>
    <description>{projectName}</description>
    <!-- 创建器可选参数（由 star-yi-cli new 写入，仅作项目约定记录）：
         apps 模块命名习惯: {appsModulePrefix}
         默认 REST 前缀: {defaultApiPrefix}
         业务 SQL 子目录: sql/{sqlSubDir}/ -->
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>

    <!--第一步加入父工程-->
    <modules>
        <module>yi-admin</module>
        <module>yi-demo</module>
        <module>yi-common</module>
    </modules>



    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <!--        satoken-->
        <sa-token.version>1.45.0</sa-token.version>
        <!--        mysql-->
        <mysql.version>8.2.0</mysql.version>
        <!-- jimmer -->
        <jimmer.version>0.10.6</jimmer.version>
        <!-- springdoc / swagger -->
        <springdoc.version>3.0.3</springdoc.version>
        <swagger-annotations.version>2.2.30</swagger-annotations.version>

    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>{groupId}</groupId>
                <artifactId>yi-admin</artifactId>
                <version>{version}</version>
            </dependency>

            <dependency>
                <groupId>{groupId}</groupId>
                <artifactId>yi-demo</artifactId>
                <version>{version}</version>
            </dependency>

            <dependency>
                <groupId>{groupId}</groupId>
                <artifactId>yi-common</artifactId>
                <version>{version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>


    <dependencies>


        <!-- Spring Web 依赖，用于构建 Web 应用程序 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- =====Sa-Token===== -->

        <!-- Sa-Token 权限认证，在线文档：https://sa-token.cc -->

        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>



        <!-- Spring Boot 测试依赖，用于单元测试和集成测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope> <!-- 仅在测试范围内生效 -->
        </dependency>
        <!-- Lombok 依赖，用于减少样板代码（如 getter/setter） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional> <!-- 标记为可选依赖 -->
        </dependency>

        <dependency>
            <groupId>org.babyfish.jimmer</groupId>
            <artifactId>jimmer-spring-boot-starter</artifactId>
            <version>${jimmer.version}</version>
        </dependency>


        <!-- 日志打印工具 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>


    </dependencies>

    <build>
        <plugins>
            <!-- Maven 编译插件，用于配置注解处理器 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <!-- 配置 Lombok 注解处理器 -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <!-- 配置 Jimmer 注解处理器 -->
                        <path>
                            <groupId>org.babyfish.jimmer</groupId>
                            <artifactId>jimmer-apt</artifactId>
                            <version>${jimmer.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven 插件，用于打包和运行 Spring Boot 应用 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.star.AppLication</mainClass>
                    <excludes>
                        <!-- 排除 Lombok 依赖，避免将其打包到最终产物中 -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
