export com.star.yidemo.model.entity.DemoArticle
    -> package com.star.yidemo.model.dto

DemoArticleView {
    #allScalars
    -deletedTime
}

input DemoArticleCreateInput {
    articleCode
    articleTitle
    content
}

dynamic input DemoArticleUpdateInput {
    id?
    articleTitle
    content
}

specification DemoArticleSpecification {
    like/i(articleCode)
    like/i(articleTitle)
}
